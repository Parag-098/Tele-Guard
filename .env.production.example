AWS_REGION=ap-south-1
ECR_REGISTRY=123456789012.dkr.ecr.ap-south-1.amazonaws.com
RELEASE_TAG=replace-with-git-commit-sha
TG_DOMAIN=teleguard.example.com
ACME_EMAIL=owner@example.com
MLFLOW_ARTIFACT_BUCKET=replace-with-private-unique-bucket
BACKUP_BUCKET=replace-with-private-backup-bucket
POSTGRES_PASSWORD=generate-long-url-safe-random-secret
TG_DATABASE_URL=postgresql+psycopg://teleguard:generate-long-url-safe-random-secret@db:5432/teleguard
MLFLOW_BACKEND_STORE_URI=postgresql+psycopg://teleguard:generate-long-url-safe-random-secret@db:5432/teleguard
TG_SECRET_KEY=replace-with-at-least-32-random-bytes
TG_ADMIN_USERNAME=admin
TG_ADMIN_PASSWORD=one-time-bootstrap-password-at-least-12-characters
