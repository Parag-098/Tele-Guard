#!/bin/bash
set -Eeuo pipefail
umask 027
dnf install -y docker amazon-cloudwatch-agent jq
systemctl enable --now amazon-ssm-agent
install -d -m 0755 /usr/local/lib/docker/cli-plugins
compose_download=$(mktemp)
trap 'rm -f -- "$compose_download"' EXIT
curl --fail --show-error --silent --location --retry 3 \
  https://github.com/docker/compose/releases/download/${compose_version}/docker-compose-linux-x86_64 \
  --output "$compose_download"
printf '%s  %s\n' '${compose_sha256}' "$compose_download" | sha256sum --check --status
install -m 0755 "$compose_download" /usr/local/lib/docker/cli-plugins/docker-compose

install -d -m 0750 /opt/teleguard /opt/teleguard/releases /opt/teleguard/deploy-state
device='/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_${volume_serial}'
for attempt in $(seq 1 90); do
  [[ -b "$device" ]] && break
  sleep 3
done
[[ -b "$device" ]] || { echo 'Expected encrypted TeleGuard EBS device not found' >&2; exit 1; }

if ! blkid -p "$device" >/dev/null 2>&1; then
  [[ -z "$(wipefs --noheadings "$device")" ]] || { echo 'Unrecognized data device signatures; refusing to format' >&2; exit 1; }
  mkfs.ext4 -L teleguard-data "$device"
fi
uuid=$(blkid -s UUID -o value "$device")
[[ -n "$uuid" ]]
grep -Fq "UUID=$uuid /opt/teleguard/deploy-state " /etc/fstab ||
  printf 'UUID=%s /opt/teleguard/deploy-state ext4 defaults,nofail 0 2\n' "$uuid" >> /etc/fstab
mountpoint -q /opt/teleguard/deploy-state || mount /opt/teleguard/deploy-state
chmod 0750 /opt/teleguard/deploy-state
install -d -m 0755 /etc/systemd/system/docker.service.d
printf '[Unit]\nRequiresMountsFor=/opt/teleguard/deploy-state\n' > /etc/systemd/system/docker.service.d/teleguard-data.conf
systemctl daemon-reload
systemctl enable --now docker
